<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_extra_service"
                  targetNamespace="http://chousik.ru/blps/bpmn">
    <bpmn:message id="Message_payment_link_assigned" name="PaymentLinkAssigned"/>
    <bpmn:message id="Message_payment_creation_failed" name="PaymentCreationFailed"/>

    <bpmn:process id="extra-service-process"
                  name="Extra Service Payment Process"
                  isExecutable="true"
                  camunda:historyTimeToLive="30">
        <bpmn:laneSet id="LaneSet_extra_service_roles">
            <bpmn:lane id="Lane_host" name="Host (lessor)">
                <bpmn:flowNodeRef>StartEvent_extra_service_created</bpmn:flowNodeRef>
            </bpmn:lane>
            <bpmn:lane id="Lane_user" name="User (renter)">
                <bpmn:flowNodeRef>Task_user_decide_payment</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Boundary_guest_decision_timeout</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Gateway_user_decision</bpmn:flowNodeRef>
            </bpmn:lane>
            <bpmn:lane id="Lane_platform" name="Platform">
                <bpmn:flowNodeRef>Task_sync_quotation</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_mark_rejected</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>EndEvent_rejected</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_request_payment</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Gateway_wait_payment_result</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Event_payment_link_assigned</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Event_payment_creation_failed</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_mark_payment_link_sent</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_sync_sales_invoice</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>EndEvent_payment_link_sent</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>Task_mark_payment_failed</bpmn:flowNodeRef>
                <bpmn:flowNodeRef>EndEvent_payment_failed</bpmn:flowNodeRef>
            </bpmn:lane>
        </bpmn:laneSet>

        <bpmn:startEvent id="StartEvent_extra_service_created" name="Extra service created">
            <bpmn:extensionElements>
                <camunda:formData>
                    <camunda:formField id="extraServiceId" label="Extra service id" type="string">
                        <camunda:validation>
                            <camunda:constraint name="required"/>
                        </camunda:validation>
                    </camunda:formField>
                    <camunda:formField id="chatId" label="Chat id" type="string"/>
                    <camunda:formField id="hostUserId" label="Host user id" type="string"/>
                    <camunda:formField id="guestUserId" label="User id" type="string"/>
                    <camunda:formField id="title" label="Service title" type="string"/>
                    <camunda:formField id="description" label="Service terms" type="string"/>
                    <camunda:formField id="amount" label="Price" type="string"/>
                    <camunda:formField id="currency" label="Currency" type="enum">
                        <camunda:value id="RUB" name="RUB"/>
                        <camunda:value id="USD" name="USD"/>
                        <camunda:value id="EUR" name="EUR"/>
                    </camunda:formField>
                </camunda:formData>
            </bpmn:extensionElements>
            <bpmn:outgoing>Flow_start_to_quotation</bpmn:outgoing>
        </bpmn:startEvent>

        <bpmn:serviceTask id="Task_sync_quotation"
                          name="Sync quotation in ERPNext"
                          camunda:type="external"
                          camunda:topic="sync-extra-service-quotation">
            <bpmn:incoming>Flow_start_to_quotation</bpmn:incoming>
            <bpmn:outgoing>Flow_quotation_to_approval</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:userTask id="Task_user_decide_payment"
                       name="User reviews payment request"
                       camunda:candidateGroups="GUEST">
            <bpmn:extensionElements>
                <camunda:formData>
                    <camunda:formField id="decision" label="Payment decision" type="enum">
                        <camunda:value id="ACCEPT" name="Confirm payment"/>
                        <camunda:value id="REJECT" name="Reject request"/>
                        <camunda:validation>
                            <camunda:constraint name="required"/>
                        </camunda:validation>
                    </camunda:formField>
                    <camunda:formField id="comment" label="Comment" type="string"/>
                </camunda:formData>
            </bpmn:extensionElements>
            <bpmn:incoming>Flow_quotation_to_approval</bpmn:incoming>
            <bpmn:outgoing>Flow_user_decision_to_gateway</bpmn:outgoing>
        </bpmn:userTask>

        <bpmn:boundaryEvent id="Boundary_guest_decision_timeout"
                            name="User ignored request"
                            attachedToRef="Task_user_decide_payment"
                            cancelActivity="true">
            <bpmn:outgoing>Flow_timeout_to_mark_rejected</bpmn:outgoing>
            <bpmn:timerEventDefinition>
                <bpmn:timeDuration xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${guestDecisionTimeout}</bpmn:timeDuration>
            </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>

        <bpmn:exclusiveGateway id="Gateway_user_decision" name="Payment decision">
            <bpmn:incoming>Flow_user_decision_to_gateway</bpmn:incoming>
            <bpmn:outgoing>Flow_decision_accept_to_request_payment</bpmn:outgoing>
            <bpmn:outgoing>Flow_decision_reject_to_mark_rejected</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <bpmn:serviceTask id="Task_mark_rejected"
                          name="Mark extra service rejected"
                          camunda:type="external"
                          camunda:topic="mark-extra-service-rejected">
            <bpmn:incoming>Flow_decision_reject_to_mark_rejected</bpmn:incoming>
            <bpmn:incoming>Flow_timeout_to_mark_rejected</bpmn:incoming>
            <bpmn:outgoing>Flow_mark_rejected_to_end</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:endEvent id="EndEvent_rejected" name="Rejected">
            <bpmn:incoming>Flow_mark_rejected_to_end</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:serviceTask id="Task_request_payment"
                          name="Request payment link"
                          camunda:type="external"
                          camunda:topic="request-extra-service-payment">
            <bpmn:incoming>Flow_decision_accept_to_request_payment</bpmn:incoming>
            <bpmn:outgoing>Flow_payment_to_wait_result</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:eventBasedGateway id="Gateway_wait_payment_result" name="Wait for payment provider result">
            <bpmn:incoming>Flow_payment_to_wait_result</bpmn:incoming>
            <bpmn:outgoing>Flow_gateway_to_payment_link</bpmn:outgoing>
            <bpmn:outgoing>Flow_gateway_to_payment_failed</bpmn:outgoing>
        </bpmn:eventBasedGateway>

        <bpmn:intermediateCatchEvent id="Event_payment_link_assigned" name="Payment link assigned">
            <bpmn:incoming>Flow_gateway_to_payment_link</bpmn:incoming>
            <bpmn:outgoing>Flow_link_to_mark_link_sent</bpmn:outgoing>
            <bpmn:messageEventDefinition messageRef="Message_payment_link_assigned"/>
        </bpmn:intermediateCatchEvent>

        <bpmn:intermediateCatchEvent id="Event_payment_creation_failed" name="Payment creation failed">
            <bpmn:incoming>Flow_gateway_to_payment_failed</bpmn:incoming>
            <bpmn:outgoing>Flow_failed_to_mark_failed</bpmn:outgoing>
            <bpmn:messageEventDefinition messageRef="Message_payment_creation_failed"/>
        </bpmn:intermediateCatchEvent>

        <bpmn:serviceTask id="Task_mark_payment_link_sent"
                          name="Mark payment link sent"
                          camunda:type="external"
                          camunda:topic="mark-payment-link-assigned">
            <bpmn:incoming>Flow_link_to_mark_link_sent</bpmn:incoming>
            <bpmn:outgoing>Flow_mark_link_to_invoice</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:serviceTask id="Task_sync_sales_invoice"
                          name="Sync sales invoice in ERPNext"
                          camunda:type="external"
                          camunda:topic="sync-extra-service-sales-invoice">
            <bpmn:incoming>Flow_mark_link_to_invoice</bpmn:incoming>
            <bpmn:outgoing>Flow_invoice_to_end</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:endEvent id="EndEvent_payment_link_sent" name="Payment link sent">
            <bpmn:incoming>Flow_invoice_to_end</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:serviceTask id="Task_mark_payment_failed"
                          name="Mark payment creation failed"
                          camunda:type="external"
                          camunda:topic="mark-payment-creation-failed">
            <bpmn:incoming>Flow_failed_to_mark_failed</bpmn:incoming>
            <bpmn:outgoing>Flow_mark_failed_to_end</bpmn:outgoing>
        </bpmn:serviceTask>

        <bpmn:endEvent id="EndEvent_payment_failed" name="Payment failed">
            <bpmn:incoming>Flow_mark_failed_to_end</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:sequenceFlow id="Flow_start_to_quotation" sourceRef="StartEvent_extra_service_created" targetRef="Task_sync_quotation"/>
        <bpmn:sequenceFlow id="Flow_quotation_to_approval" sourceRef="Task_sync_quotation" targetRef="Task_user_decide_payment"/>
        <bpmn:sequenceFlow id="Flow_user_decision_to_gateway" sourceRef="Task_user_decide_payment" targetRef="Gateway_user_decision"/>
        <bpmn:sequenceFlow id="Flow_decision_accept_to_request_payment" sourceRef="Gateway_user_decision" targetRef="Task_request_payment">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${decision == 'ACCEPT'}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_decision_reject_to_mark_rejected" sourceRef="Gateway_user_decision" targetRef="Task_mark_rejected">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${decision == 'REJECT'}</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_timeout_to_mark_rejected" sourceRef="Boundary_guest_decision_timeout" targetRef="Task_mark_rejected"/>
        <bpmn:sequenceFlow id="Flow_mark_rejected_to_end" sourceRef="Task_mark_rejected" targetRef="EndEvent_rejected"/>
        <bpmn:sequenceFlow id="Flow_payment_to_wait_result" sourceRef="Task_request_payment" targetRef="Gateway_wait_payment_result"/>
        <bpmn:sequenceFlow id="Flow_gateway_to_payment_link" sourceRef="Gateway_wait_payment_result" targetRef="Event_payment_link_assigned"/>
        <bpmn:sequenceFlow id="Flow_gateway_to_payment_failed" sourceRef="Gateway_wait_payment_result" targetRef="Event_payment_creation_failed"/>
        <bpmn:sequenceFlow id="Flow_link_to_mark_link_sent" sourceRef="Event_payment_link_assigned" targetRef="Task_mark_payment_link_sent"/>
        <bpmn:sequenceFlow id="Flow_mark_link_to_invoice" sourceRef="Task_mark_payment_link_sent" targetRef="Task_sync_sales_invoice"/>
        <bpmn:sequenceFlow id="Flow_invoice_to_end" sourceRef="Task_sync_sales_invoice" targetRef="EndEvent_payment_link_sent"/>
        <bpmn:sequenceFlow id="Flow_failed_to_mark_failed" sourceRef="Event_payment_creation_failed" targetRef="Task_mark_payment_failed"/>
        <bpmn:sequenceFlow id="Flow_mark_failed_to_end" sourceRef="Task_mark_payment_failed" targetRef="EndEvent_payment_failed"/>
    </bpmn:process>

    <bpmndi:BPMNDiagram id="BPMNDiagram_extra_service">
        <bpmndi:BPMNPlane id="BPMNPlane_extra_service" bpmnElement="extra-service-process">
            <bpmndi:BPMNShape id="Lane_host_di" bpmnElement="Lane_host" isHorizontal="true">
                <dc:Bounds x="60" y="40" width="1600" height="120"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Lane_user_di" bpmnElement="Lane_user" isHorizontal="true">
                <dc:Bounds x="60" y="160" width="1600" height="260"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Lane_platform_di" bpmnElement="Lane_platform" isHorizontal="true">
                <dc:Bounds x="60" y="420" width="1600" height="260"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNShape id="StartEvent_extra_service_created_di" bpmnElement="StartEvent_extra_service_created">
                <dc:Bounds x="130" y="82" width="36" height="36"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="107" y="125" width="86" height="27"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_sync_quotation_di" bpmnElement="Task_sync_quotation">
                <dc:Bounds x="230" y="510" width="150" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_user_decide_payment_di" bpmnElement="Task_user_decide_payment">
                <dc:Bounds x="450" y="250" width="170" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Boundary_guest_decision_timeout_di" bpmnElement="Boundary_guest_decision_timeout">
                <dc:Bounds x="565" y="312" width="36" height="36"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="552" y="355" width="70" height="27"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Gateway_user_decision_di" bpmnElement="Gateway_user_decision" isMarkerVisible="true">
                <dc:Bounds x="700" y="265" width="50" height="50"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="685" y="322" width="82" height="27"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_request_payment_di" bpmnElement="Task_request_payment">
                <dc:Bounds x="680" y="510" width="150" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Gateway_wait_payment_result_di" bpmnElement="Gateway_wait_payment_result">
                <dc:Bounds x="900" y="525" width="50" height="50"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="884" y="582" width="82" height="40"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Event_payment_link_assigned_di" bpmnElement="Event_payment_link_assigned">
                <dc:Bounds x="1030" y="445" width="36" height="36"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="1013" y="488" width="70" height="27"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_mark_payment_link_sent_di" bpmnElement="Task_mark_payment_link_sent">
                <dc:Bounds x="1130" y="423" width="150" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_sync_sales_invoice_di" bpmnElement="Task_sync_sales_invoice">
                <dc:Bounds x="1340" y="423" width="150" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="EndEvent_payment_link_sent_di" bpmnElement="EndEvent_payment_link_sent">
                <dc:Bounds x="1540" y="445" width="36" height="36"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="1519" y="488" width="78" height="27"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Event_payment_creation_failed_di" bpmnElement="Event_payment_creation_failed">
                <dc:Bounds x="1030" y="570" width="36" height="36"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="1015" y="613" width="67" height="40"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_mark_payment_failed_di" bpmnElement="Task_mark_payment_failed">
                <dc:Bounds x="1130" y="548" width="150" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="EndEvent_payment_failed_di" bpmnElement="EndEvent_payment_failed">
                <dc:Bounds x="1350" y="570" width="36" height="36"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="1332" y="613" width="72" height="27"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="Task_mark_rejected_di" bpmnElement="Task_mark_rejected">
                <dc:Bounds x="680" y="600" width="150" height="60"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="EndEvent_rejected_di" bpmnElement="EndEvent_rejected">
                <dc:Bounds x="910" y="612" width="36" height="36"/>
                <bpmndi:BPMNLabel>
                    <dc:Bounds x="907" y="655" width="42" height="14"/>
                </bpmndi:BPMNLabel>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNEdge id="Flow_start_to_quotation_di" bpmnElement="Flow_start_to_quotation">
                <di:waypoint x="166" y="100"/>
                <di:waypoint x="305" y="100"/>
                <di:waypoint x="305" y="510"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_quotation_to_approval_di" bpmnElement="Flow_quotation_to_approval">
                <di:waypoint x="380" y="550"/>
                <di:waypoint x="535" y="550"/>
                <di:waypoint x="535" y="330"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_user_decision_to_gateway_di" bpmnElement="Flow_user_decision_to_gateway">
                <di:waypoint x="620" y="290"/>
                <di:waypoint x="700" y="290"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_decision_accept_to_request_payment_di" bpmnElement="Flow_decision_accept_to_request_payment">
                <di:waypoint x="725" y="315"/>
                <di:waypoint x="725" y="510"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_decision_reject_to_mark_rejected_di" bpmnElement="Flow_decision_reject_to_mark_rejected">
                <di:waypoint x="750" y="290"/>
                <di:waypoint x="850" y="290"/>
                <di:waypoint x="850" y="630"/>
                <di:waypoint x="830" y="630"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_timeout_to_mark_rejected_di" bpmnElement="Flow_timeout_to_mark_rejected">
                <di:waypoint x="583" y="348"/>
                <di:waypoint x="583" y="640"/>
                <di:waypoint x="680" y="640"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_mark_rejected_to_end_di" bpmnElement="Flow_mark_rejected_to_end">
                <di:waypoint x="830" y="630"/>
                <di:waypoint x="910" y="630"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_payment_to_wait_result_di" bpmnElement="Flow_payment_to_wait_result">
                <di:waypoint x="830" y="550"/>
                <di:waypoint x="900" y="550"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_gateway_to_payment_link_di" bpmnElement="Flow_gateway_to_payment_link">
                <di:waypoint x="925" y="525"/>
                <di:waypoint x="925" y="463"/>
                <di:waypoint x="1030" y="463"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_gateway_to_payment_failed_di" bpmnElement="Flow_gateway_to_payment_failed">
                <di:waypoint x="925" y="575"/>
                <di:waypoint x="925" y="588"/>
                <di:waypoint x="1030" y="588"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_link_to_mark_link_sent_di" bpmnElement="Flow_link_to_mark_link_sent">
                <di:waypoint x="1066" y="463"/>
                <di:waypoint x="1130" y="463"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_mark_link_to_invoice_di" bpmnElement="Flow_mark_link_to_invoice">
                <di:waypoint x="1280" y="463"/>
                <di:waypoint x="1340" y="463"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_invoice_to_end_di" bpmnElement="Flow_invoice_to_end">
                <di:waypoint x="1490" y="463"/>
                <di:waypoint x="1540" y="463"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_failed_to_mark_failed_di" bpmnElement="Flow_failed_to_mark_failed">
                <di:waypoint x="1066" y="588"/>
                <di:waypoint x="1130" y="588"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="Flow_mark_failed_to_end_di" bpmnElement="Flow_mark_failed_to_end">
                <di:waypoint x="1280" y="588"/>
                <di:waypoint x="1350" y="588"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</bpmn:definitions>
